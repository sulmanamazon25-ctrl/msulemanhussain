# Shop / Stripe (self-hosted Coolify)
# Copy values into Coolify env for the web service. Never commit real secrets.

DATABASE_URL=postgres://shop:CHANGE_ME@postgres:5432/msulemanhussain_shop
UPLOAD_DIR=/app/data/uploads
SHOP_CURRENCY=eur

ADMIN_PASSWORD=CHANGE_ME_STRONG
SESSION_SECRET=CHANGE_ME_LONG_RANDOM

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# SMTP (mailbox you already control) — receipts + order alerts
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=noreply@msulemanhussain.com
SMTP_PASS=CHANGE_ME
SMTP_FROM=noreply@msulemanhussain.com

NEXT_PUBLIC_SITE_URL=https://msulemanhussain.com
